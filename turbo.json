{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": ["HUSTLE_API_ORIGIN"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "env": ["DATABASE_URL", "CHAIN_MODE", "NEAR_SANDBOX_TESTS"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["WEB_PORT"]
    }
  }
}
