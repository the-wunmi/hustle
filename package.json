{
  "name": "hustle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm install && node scripts/ensure-env.mjs && pnpm db:up && pnpm db:migrate",
    "start": "pnpm db:up && pnpm db:migrate && pnpm dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @hustle/db generate",
    "db:migrate": "pnpm --filter @hustle/db migrate",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @hustle/api dev",
    "dev:web": "pnpm --filter @hustle/web dev",
    "simulate": "tsx packages/economy/scripts/simulate.ts",
    "simulate:owners": "tsx packages/economy/scripts/policies.ts",
    "contracts:build": "bash scripts/build-contracts.sh",
    "contracts:test": "cd contracts && cargo test",
    "test:chain": "NEAR_SANDBOX_TESTS=1 pnpm --filter @hustle/chain test",
    "reset": "pnpm --filter @hustle/db reset",
    "dev:chain": "pnpm --filter @hustle/chain dev",
    "deploy:testnet": "tsx --env-file-if-exists=.env packages/engine/scripts/deploy-testnet.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
