# Copy to .env (`pnpm run setup` does it). Every amount is credits; nothing here touches real money. Live
# services are used wherever their settings are filled in (see each section).

# Postgres 17 from docker-compose.yml (port 5436). Compose applies POSTGRES_PASSWORD when its volume
# is first created; DATABASE_URL must use the same password.
POSTGRES_PASSWORD=hustle
DATABASE_URL=postgres://hustle:hustle@localhost:5436/hustle
# DBOS keeps workflow checkpoints in its own database on the same server (created on first start).
# Empty means <DATABASE_URL's database>_dbos, here hustle_dbos.
DBOS_SYSTEM_DATABASE_URL=

# Server secret: seals per-agent provider keys and keys the simulators. `pnpm run setup` generates one.
HUSTLE_SECRET=

# World pace. A tick is TICK_MS real milliseconds; a game day is DAY_TICKS ticks (default 6 minutes).
TICK_MS=2000
DAY_TICKS=180

# ── Chain ─────────────────────────────────────────────────────────────────────────────────────
# Empty: NEAR testnet when NEAR_TESTNET_ACCOUNT_ID is set (contracts deployed first with
# `pnpm deploy:testnet`, README "Deploy to NEAR testnet"), else a local NEAR node (nearcore's sandbox
# build) that `pnpm dev` starts, with the contracts deployed on first run; state in .near-sandbox/.
# testnet | sandbox force one. sim is a Postgres stand-in for the fast tests. Mainnet is refused.
CHAIN_MODE=
# Optional: the node's RPC port (3330), peer port (24730) and home directory. Change both ports to run
# a second copy of the game next to the first.
NEAR_RPC_PORT=
NEAR_NET_PORT=
NEAR_SANDBOX_HOME=

# ── NEAR testnet (only for `pnpm deploy:testnet` and CHAIN_MODE=testnet) ────────────────────────
# A testnet account you created (it must end in .testnet) and its full-access private key
# (ed25519:...). The deploy puts the contracts under it (credits.<account>, agents.<account>, ...)
# and every account the game creates gets this key. Fund it with about 70 testnet NEAR (README
# "Deploy to NEAR testnet"; `pnpm deploy:testnet --plan` prints the exact cost). The key is never
# printed or logged. To play on testnet from this machine: `pnpm reset`, then `HUSTLE_LIVE_WORLD=1 pnpm dev`.
NEAR_TESTNET_ACCOUNT_ID=
NEAR_TESTNET_PRIVATE_KEY=
# Optional: a testnet RPC (https, and the node must report chain id "testnet"). Default:
# https://test.rpc.fastnear.com. In sandbox mode this overrides the local node's URL instead.
NEAR_RPC_URL=

# ── NEAR AI Cloud (agent brains, metering, attestation) ─────────────────────────────────────
# With NEARAI_API_KEY set (an sk- key from an org with prepaid credits), players' agents think with
# live models; house agents (the game's computer players) always use scripted replies. Without a key
# every agent uses the scripted replies, labelled as such. NEARAI_MODE=mock forces that; =live
# without a key refuses to boot.
NEARAI_MODE=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
# Optional, for one API key per agent with a spend limit (POST /v1/workspaces/{ws}/api-keys).
NEARAI_SESSION_TOKEN=
NEARAI_WORKSPACE_ID=

# ── Sign-in ──────────────────────────────────────────────────────────────────────────────────
# A NEAR testnet wallet always works (no settings). NEAR Auth's popup (testnet tenant, shared client
# id) is offered where its client accepts the origin: only http://localhost:3000
# (WEB_PORT=3000 pnpm dev). AUTH_MODE=mock adds a labelled stand-in whose email code shows on screen;
# with NODE_ENV=production it is offered only if ALLOW_MOCK_AUTH=1.
AUTH_MODE=
ALLOW_MOCK_AUTH=
NEAR_AUTH_DOMAIN=
NEAR_AUTH_CLIENT_ID=

# ── Server (docker compose --profile app up -d --build --wait) ──────────────────────────────────
# Compose overrides DATABASE_URL and DBOS_SYSTEM_DATABASE_URL with the in-network database and sets
# CHAIN_MODE=testnet unless you set it here. On a server: a strong POSTGRES_PASSWORD, a fresh
# HUSTLE_SECRET, the testnet account above and PUBLIC_ORIGIN. Leave AUTH_MODE empty: NEAR wallet
# sign-in works on any domain, and production refuses the stand-in.
# The public URL: writes from any other origin are refused, and the session cookie is Secure.
PUBLIC_ORIGIN=
# off = the testnet deploy ran without global wallet code; must match how it ran.
WALLET_CODE_GLOBAL=
# Backup RPCs, comma-separated, fastest first (default: dRPC, FastNEAR, Intear and
# rpc.testnet.near.org, minus whichever is NEAR_RPC_URL).
NEAR_RPC_FALLBACK_URLS=
# The NEAR the root and the operator keep back (no new accounts or agents below it).
NEAR_RESERVE_ROOT=
NEAR_RESERVE_OPERATOR=
